{
  "info": {
    "_postman_id": "d2d0b0a7-7f89-4db8-9ecf-2c9f0c0a8f01",
    "name": "Hospital System - Agendamento Authorization",
    "description": "Collection para validar as regras de acesso do paciente no GraphQL do api-agendamento.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/graphql"
    },
    {
      "key": "username",
      "value": "seu-email-paciente@exemplo.com"
    },
    {
      "key": "password",
      "value": "sua-senha"
    },
    {
      "key": "ownPatientId",
      "value": ""
    },
    {
      "key": "otherPatientId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Obter usuario autenticado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8081/graphql",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8081",
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query { usuarioAutenticado { id nome email tipo authorities } }\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Usuario autenticado foi retornado', function () {",
              "  pm.expect(json.data).to.have.property('usuarioAutenticado');",
              "});",
              "",
              "pm.collectionVariables.set('ownPatientId', json.data.usuarioAutenticado.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Agendamentos do proprio paciente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8081/graphql",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8081",
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query ($idPaciente: ID!) { agendamentosPorPaciente(idPaciente: $idPaciente) { id medicoId pacienteId dataHora status especialidade observacoes createdAt updatedAt } }\",\n  \"variables\": {\n    \"idPaciente\": \"{{ownPatientId}}\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Nao possui erro GraphQL', function () {",
              "  pm.expect(json.errors).to.be.undefined;",
              "});",
              "",
              "pm.test('Todos os agendamentos pertencem ao paciente autenticado', function () {",
              "  const items = json.data.agendamentosPorPaciente || [];",
              "  items.forEach(function (item) {",
              "    pm.expect(item.pacienteId).to.eql(pm.collectionVariables.get('ownPatientId'));",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Tentativa de acessar agendamentos de terceiro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8081/graphql",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8081",
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query ($idPaciente: ID!) { agendamentosPorPaciente(idPaciente: $idPaciente) { id medicoId pacienteId dataHora status especialidade observacoes createdAt updatedAt } }\",\n  \"variables\": {\n    \"idPaciente\": \"{{otherPatientId}}\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 200 com erro GraphQL controlado', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Resposta contem errors', function () {",
              "  pm.expect(json.errors).to.be.an('array');",
              "});",
              "",
              "pm.test('Erro classificado como FORBIDDEN', function () {",
              "  const extensions = json.errors[0].extensions || {};",
              "  pm.expect(extensions.classification || extensions.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}